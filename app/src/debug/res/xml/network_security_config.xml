<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only override of src/main/res/xml/network_security_config.xml.
    Permits cleartext HTTP so debug builds can reach a local AvagoSvc
    (avago.api.target=local, e.g. http://10.0.2.2:8080 or a LAN IP) and
    trusts user CAs (proxy debugging). Release builds use the main config,
    which stays HTTPS-only.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration,AcceptsUserCertificates">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
