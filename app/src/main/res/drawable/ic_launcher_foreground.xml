<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: white wrench on transparent (the launcher
  background drawable supplies the red fill). Matches iOS AppIcon.png:
  pure red field, white wrench rotated diagonally bottom-right to top-left.

  Adaptive icons require a 108x108dp viewport with the safe zone in the
  center 72x72dp circle. We scale the Material 'build' (wrench) path
  (24x24 source viewport) by ~3.5x and offset to land it centered.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="12"
        android:translateY="12"
        android:scaleX="3.5"
        android:scaleY="3.5">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M22.7,19l-9.1,-9.1c0.9,-2.3 0.4,-5 -1.5,-6.9 -2,-2 -5,-2.4 -7.4,-1.3L9,6 6,9 1.6,4.7C0.4,7.1 0.9,10.1 2.9,12.1c1.9,1.9 4.6,2.4 6.9,1.5l9.1,9.1c0.4,0.4 1,0.4 1.4,0l2.3,-2.3c0.5,-0.4 0.5,-1.1 0.1,-1.4z" />
    </group>
</vector>
