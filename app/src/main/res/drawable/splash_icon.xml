<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ SplashScreen icon. The framework crops to a 240x240dp viewport
  and only shows the inner 160x160dp safe zone (clipped to a circle by the
  splash framework). To get the "iOS app icon" look (red field + white wrench)
  we paint the red field INSIDE this drawable so it reads as a centered icon
  on the neutral page background, rather than a full-screen red wash.

  The outer red path fills the full 240×240 viewport — the splash framework
  will mask it to a circle, producing the red disc behind the wrench.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="240dp"
    android:height="240dp"
    android:viewportWidth="240"
    android:viewportHeight="240">
    <!-- Red disc (framework clips to circle) -->
    <path
        android:fillColor="#FF0000"
        android:pathData="M0,0 L240,0 L240,240 L0,240 Z" />
    <!-- White wrench centered in the 160dp safe zone (scale 5×, center offset 60) -->
    <group
        android:translateX="60"
        android:translateY="60"
        android:scaleX="5"
        android:scaleY="5">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M22.7,19l-9.1,-9.1c0.9,-2.3 0.4,-5 -1.5,-6.9 -2,-2 -5,-2.4 -7.4,-1.3L9,6 6,9 1.6,4.7C0.4,7.1 0.9,10.1 2.9,12.1c1.9,1.9 4.6,2.4 6.9,1.5l9.1,9.1c0.4,0.4 1,0.4 1.4,0l2.3,-2.3c0.5,-0.4 0.5,-1.1 0.1,-1.4z" />
    </group>
</vector>
